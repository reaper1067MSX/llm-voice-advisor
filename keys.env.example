# ==============================================================================
# LLM GAME ADVISOR — CONFIGURACIÓN DE CLAVES DE API (keys.env)
# ==============================================================================
# Este archivo permite configurar fácilmente las claves de acceso de los modelos
# sin tener que modificar el archivo principal config.yaml.
#
# 1. Copia o renombra este archivo como 'keys.env' en esta misma carpeta.
# 2. Pega tu clave de API correspondiente sin comillas ni espacios adicionales.
# ==============================================================================

# Clave de Google Gemini (Proveedor por defecto):
# Obtenla gratis en: https://aistudio.google.com/
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Clave de Moonshot AI (Kimi K2.6):
# Obtenla en: https://platform.moonshot.ai/
# MOONSHOT_API_KEY=sk-tu_clave_de_moonshot_aqui

# Clave de NVIDIA NIM (Opcional, si configuras llm.provider: nvidia en config.yaml):
# Obtenla en: https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-tu_clave_de_nvidia_aqui
